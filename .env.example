# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=qacommand
POSTGRES_USER=qacommand
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://qacommand:change_me_strong_password@db:5432/qacommand

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
CLAUDE_MODEL=claude-sonnet-4-6

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=change_me_secret_key_min_32_chars
API_URL=https://qa.zaimahtech.ae/api
WEB_URL=https://qa.zaimahtech.ae

# ── Email (SMTP) — Phase 2, not wired yet ──────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=qa-command@zaimahtech.ae

# ── Microsoft Graph (Outlook send) — Phase 2, not wired yet ────────────────────
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=

# ── Azure DevOps (Phase 2) ──────────────────────────────────────────────────────
# Symmetric key used to encrypt the ADO Personal Access Token at rest — the app
# refuses to save or read an ADO connection without this set (never falls back to
# storing the PAT in plaintext). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key makes any already-saved PAT undecryptable — reconnect
# ADO from the settings screen to re-save it under the new key.
ADO_ENCRYPTION_KEY=

# ── Next.js ───────────────────────────────────────────────────────────────────
# Domain ROOT only — NO /api suffix, NO trailing slash. Every frontend fetch call
# already prepends /api itself (see web/lib/api.ts), so a value ending in /api
# here produces double /api/api/... paths that 404.
# This is also baked into the client bundle at BUILD time (Next.js inlines
# NEXT_PUBLIC_* vars during `next build`), not read at container runtime — so
# changing this value requires rebuilding the web image, not just restarting it.
# docker-compose.yml passes it to the web service as both a build arg and a
# runtime env for that reason.
NEXT_PUBLIC_API_URL=https://qa.zaimahtech.ae
PORT=3000
